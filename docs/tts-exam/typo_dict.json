  "context_patterns": [
    {
      "pattern": "표현대리.*아기",
      "note": "표현대리 문맥의 '아기'는 '악의' (선의/악의 구분)"
    },
    {
      "pattern": "본인.*아기",
      "note": "본인의 '아기' → '악의' (대리 무권 등 문맥)"
    },
    {
      "pattern": "제3자.*아기",
      "note": "제3자 '아기' → '악의'"
    },
    {
      "pattern": "제삼자.*아기",
      "note": "제삼자 '아기' → '악의'"
    },
    {
      "pattern": "통정.*표시",
      "note": "통정표시 → 통정허위표시 (제108조 관련)"
    },
    {
      "pattern": "선한[\\s]*간리[\\s]*주의",
      "note": "선한간리주의 → 선량한 관리자의 주의"
    },
    {
      "pattern": "선한[\\s]*관리[\\s]*주의",
      "note": "선한관리주의 → 선량한 관리자의 주의"
    },
    {
      "pattern": "파산[\\s]*관[제계계임][\\s]*인",
      "note": "파산관제/관계인 → 파산관재인"
    },
    {
      "pattern": "(시효.*이후의|이후의.*시효)",
      "note": "시효 컨텍스트의 '이후의' → '사후의' (att 19 미케02-14 ceo=시효 패턴 동반)"
    }
  ],
