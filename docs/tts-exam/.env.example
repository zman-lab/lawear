# Lawear Exam Console — env 예제
# 사용법:
#   1. 본 파일을 `.env`로 복사:  cp .env.example .env
#   2. ANTHROPIC_API_KEY 등을 실제 값으로 채움
#   3. server.py 가 시작 시 자동 로드 (env_loader.load_env)
#
# 주의: `.env` 자체는 .gitignore 처리 — git 추적 X.

# ─── 필수 ────────────────────────────────────────────────────
# Claude 채점 호출 (Anthropic API)
# 미설정 시 grader.py 는 mock 응답 반환 (단위 테스트 + 부팅 OK)
ANTHROPIC_API_KEY=sk-ant-

# ─── 옵션 (기본값 있음, 필요 시만 오버라이드) ─────────────────
# 케이스 .md 파일 베이스 경로
LAWEAR_TTS_BASE=/Users/nhn/zman-lab/lawear/docs/tts-new

# 17896 서버 포트/바인드
LAWEAR_EXAM_PORT=17896
LAWEAR_EXAM_BIND=127.0.0.1

# 17896 SQLite DB 경로
LAWEAR_EXAM_DB=exam.db

# 17895 remote (Sync fetch 대상)
LAWEAR_REMOTE_BASE=http://127.0.0.1:17895
LAWEAR_REMOTE_TIMEOUT=10

# Claude 모델 (dev-design #48 Q11 결정)
LAWEAR_GRADER_MODEL=claude-opus-4-7

# Grader mock 강제 (1=강제 mock, 0=API 호출 시도)
# 미설정/0 + ANTHROPIC_API_KEY 미설정 → 자동 mock
LAWEAR_GRADER_MOCK=0
